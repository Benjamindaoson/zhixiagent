# Example only. Copy to .env and replace placeholders with your own values.
# .env is ignored by Git; never commit a real API key.
DISABLE_DISPLAY_KEYS=true
CLOUDCODE_ENABLED=true
CLOUDCODE_ENDPOINT=openai
CLOUDCODE_API_KEY=replace-with-your-own-key
CLOUDCODE_API_BASE=https://your-openai-compatible-provider.example/v1
CLOUDCODE_MODELS=your-model-id
